from pathlib import Path

def make_code(display_name, pdf_path, output_json, image_map_path, manual_type):
    return f'''import fitz
import os
import json
import re

# =========================================================
# {display_name} PDF → JSON
# 1. 只抽文字
# 2. 不重新抽圖片
# 3. 只讀自己的 image_map
# 4. metadata.images 只保存圖片路徑
# =========================================================

PDF_PATH = "{pdf_path}"
OUTPUT_JSON = "{output_json}"
IMAGE_MAP_PATH = "{image_map_path}"
MANUAL_TYPE = "{manual_type}"

os.makedirs("data", exist_ok=True)

if os.path.exists(IMAGE_MAP_PATH):
    with open(IMAGE_MAP_PATH, "r", encoding="utf-8") as f:
        IMAGE_MAP = json.load(f)
else:
    IMAGE_MAP = {{}}
    print(f"警告：找不到 {{IMAGE_MAP_PATH}}，圖片 metadata 會是空的")


def clean_text(text: str) -> str:
    text = text or ""
    text = text.replace("\\x00", "")
    text = re.sub(r"[ \\t]+", " ", text)
    text = re.sub(r"\\n{{3,}}", "\\n\\n", text)
    return text.strip()


def detect_codes(text: str):
    patterns = [
        r"\\bG\\d{{1,3}}(?:\\.\\d)?\\b",
        r"\\bM\\d{{1,3}}\\b",
        r"\\bINT\\s*\\d+\\b",
        r"\\bMOT\\s*\\d+\\b",
        r"\\bOP\\s*\\d+\\b",
        r"\\bRTEX\\s*\\d+\\b",
        r"\\bEtherCAT\\b",
        r"\\b\\d{{3,4}}[-－][A-Za-z0-9]{{1,6}}\\b",
        r"\\b\\d{{4}}\\b",
        r"\\bP\\d{{1,5}}\\b",
        r"\\bPRM\\s*\\d+\\b",
        r"\\bALM\\s*\\d+\\b",
    ]

    codes = []
    for p in patterns:
        codes.extend(re.findall(p, text, flags=re.IGNORECASE))

    return list(dict.fromkeys(codes))


def get_images_for_page(page_no: int):
    page_key = str(page_no)
    images = []

    if page_key not in IMAGE_MAP:
        return images

    for item in IMAGE_MAP[page_key]:
        img = str(item).strip()

        if not img:
            continue

        if img.startswith("/static/") or img.startswith("http"):
            images.append(img)
        else:
            images.append(f"/static/images/{{img}}")

    return images


def parse_toc_for_programming(doc):
    if MANUAL_TYPE != "programming":
        return []

    toc_text = ""

    for i in range(min(2, len(doc))):
        toc_text += "\\n" + doc[i].get_text("text")

    normalized = re.sub(r"\\s+", " ", toc_text)
    items = []

    pattern = r"(\\d+\\.\\d+)\\s+(.+?)\\s+\\.{{3,}}\\s+(\\d+)"

    for m in re.finditer(pattern, normalized):
        number = m.group(1).strip()
        title = m.group(2).strip()
        page = int(m.group(3))

        items.append({{
            "number": number,
            "title": title,
            "start_page": page,
            "minor_title": f"{{number}} {{title}}",
        }})

    for i, item in enumerate(items):
        if i + 1 < len(items):
            item["end_page"] = items[i + 1]["start_page"] - 1
        else:
            item["end_page"] = 9999

    return items


def find_programming_minor_title(page_no: int, toc_items):
    if MANUAL_TYPE != "programming":
        return ""

    for item in toc_items:
        if item["start_page"] <= page_no <= item["end_page"]:
            return item["minor_title"]

    return ""


def guess_major_title(page_no: int, text: str) -> str:
    if MANUAL_TYPE == "programming":
        if page_no <= 111:
            return "一、G 碼指令"
        elif page_no <= 118:
            return "二、M 輔助機能"
        else:
            return "三、巨集程式"

    lines = [line.strip() for line in text.splitlines() if line.strip()]

    for line in lines[:8]:
        if 2 <= len(line) <= 60:
            return line

    return "{display_name}"


def guess_minor_title(text: str) -> str:
    lines = [line.strip() for line in text.splitlines() if line.strip()]

    for line in lines[:12]:
        if re.match(r"^(\\d+(\\.\\d+)*|[一二三四五六七八九十]+[、.])", line):
            return line[:80]

    for line in lines[:15]:
        if "警報" in line or "參數" in line or "異常" in line or "維修" in line:
            return line[:80]

    if lines:
        return lines[0][:80]

    return ""


def detect_content_type(text: str) -> str:
    if not text:
        return "text"

    upper_text = text.upper()

    if "TYPE A" in text and "TYPE B" in text and "TYPE C" in text:
        return "table"

    if "警報" in text or "ALARM" in upper_text or "異常" in text:
        return "alarm"

    if "參數" in text or "PARAMETER" in upper_text:
        return "parameter"

    if "表" in text and ("項目" in text or "說明" in text or "名稱" in text):
        return "table_or_list"

    if "檢查" in text or "更換" in text or "調整" in text or "維修" in text:
        return "maintenance_instruction"

    if "原因" in text or "處理" in text or "解除" in text or "對策" in text:
        return "troubleshooting"

    if "指令格式" in text or "範例" in text or "注意事項" in text:
        return "instruction"

    return "text"


def main():
    if not os.path.exists(PDF_PATH):
        raise FileNotFoundError(f"找不到 PDF：{{PDF_PATH}}")

    doc = fitz.open(PDF_PATH)
    source_file = os.path.basename(PDF_PATH)
    toc_items = parse_toc_for_programming(doc)

    records = []
    record_id = 1

    for page_index in range(len(doc)):
        page_no = page_index + 1
        page = doc[page_index]

        text = clean_text(page.get_text("text"))

        if not text:
            continue

        major_title = guess_major_title(page_no, text)

        if MANUAL_TYPE == "programming":
            minor_title = find_programming_minor_title(page_no, toc_items) or guess_minor_title(text)
        else:
            minor_title = guess_minor_title(text)

        section = minor_title or major_title
        content_type = detect_content_type(text)
        codes = detect_codes(text)
        images = get_images_for_page(page_no)

        metadata = {{
            "page": page_no,
            "source_pdf": source_file,
            "manual_type": MANUAL_TYPE,
            "section": section,
            "major_title": major_title,
            "minor_title": minor_title,
            "content_type": content_type,
            "codes": codes,
            "images": images,
            "image_map_source": IMAGE_MAP_PATH,
        }}

        records.append({{
            "id": record_id,
            "page": page_no,
            "metadata": metadata,
            "text": text
        }})

        print(f"完成 page={{page_no}}, images={{len(images)}}, title={{minor_title}}")

        record_id += 1

    doc.close()

    with open(OUTPUT_JSON, "w", encoding="utf-8") as f:
        json.dump(records, f, ensure_ascii=False, indent=2)

    print("\\n=== 完成 ===")
    print(f"輸出 JSON：{{OUTPUT_JSON}}")
    print(f"總筆數：{{len(records)}}")
    print(f"使用 image_map：{{IMAGE_MAP_PATH}}")


if __name__ == "__main__":
    main()
'''

configs = [
    ("pdf_to_json_programming_metadata_separate.py", "L2100 車床程式說明手冊", "L2100 車床程式說明手冊.pdf", "data/l2100_programming_metadata.json", "image_map_programming.json", "programming"),
    ("pdf_to_json_maintenance_metadata_separate.py", "L2100 車床中文維護手冊", "L2100車床中文維護手冊(全).pdf", "data/l2100_maintenance_metadata.json", "image_map_maintenance.json", "maintenance"),
    ("pdf_to_json_parameter_alarm_metadata_separate.py", "L2100 車床參數警報手冊", "L2100車床參數警報手冊.pdf", "data/l2100_parameter_alarm_metadata.json", "image_map_parameter_alarm.json", "parameter_alarm"),
]

for filename, display_name, pdf_path, output_json, image_map_path, manual_type in configs:
    out = Path("/mnt/data") / filename
    out.write_text(make_code(display_name, pdf_path, output_json, image_map_path, manual_type), encoding="utf-8")
    print(out)
